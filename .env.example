# Supabase Cloud Database Configuration
# Lấy từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Tùy chọn: Service Role Key (dùng cho backend/server-side admin, không để lộ ra client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Maps Platform Geocoding API Key
# Dùng để lấy tọa độ chính xác và google_place_id khi người dùng đăng bất động sản mới
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
